\centering
\includegraphics[width = 0.7\textwidth]{sim_cv/cv_p1000_nrep50_runtime}
\includegraphics[width = 0.7\textwidth]{sim_cv/cv_p1000_nrep50_metric}
\caption{Test error and runtimes across different \code{fast\_fit} options
for Gaussian (bottom row) and
binomial (top row) GLMs for
(\code{rp\_gaussian()} + \code{screen\_marglik()} and
\code{rp\_cw(data=TRUE)} + \code{screen\_glmnet()}.\label{fig:cvmodes}}
\end{figure}
